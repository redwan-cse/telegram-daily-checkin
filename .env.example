# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash

# Required: encryption key for encrypted SQLite session storage.
# Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SESSION_ENCRYPTION_KEY=replace_with_fernet_key

# Config and persistence paths inside Docker/container.
CHECKIN_CONFIG_PATH=/app/config.yaml
DATA_DIR=/app/data
LOGS_DIR=/app/logs
SESSION_DB_PATH=/app/data/sessions.sqlite3
LOG_FILE=/app/logs/checkin.log

# Optional SOCKS5 proxy. These can also be set in config.yaml.
PROXY_ENABLED=false
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional Telegram execution report delivery.
# Use a bot token/chat ID for your Hermes/OpenClaw Telegram destination.
REPORT_ENABLED=false
REPORT_BOT_TOKEN=
REPORT_CHAT_ID=
REPORT_LABEL=telegram-daily-checkin
