# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash

# Persistent session file name; creates primary_account.session on first run.
SESSION_NAME=primary_account

# Comma-separated bot usernames.
TARGET_BOTS=@BotA,@BotB

# Command to send to every bot.
CHECKIN_COMMAND=/checkin

# Randomized start delay for cron-triggered runs: default 1-15 minutes.
INITIAL_DELAY_MIN_SECONDS=60
INITIAL_DELAY_MAX_SECONDS=900

# Delay between bots: default 20-75 seconds.
BETWEEN_BOT_MIN_SECONDS=20
BETWEEN_BOT_MAX_SECONDS=75

# SOCKS5 proxy support. Leave disabled unless you use a trusted proxy.
PROXY_ENABLED=false
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USERNAME=
PROXY_PASSWORD=
